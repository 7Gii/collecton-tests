{
  "id": "e76ada00-6a92-42ee-8612-b586df03ee32",
  "name": "sante_maternelle",
  "title": "Santé maternelle",
  "icon": "workflow_icon_default",
  "comments": [
    "Suivi maternel des femmes de 15 à 40 ans : diagnostic, CPN, accouchement, postnatal."
  ],
  "displayExpression": "estEligible",
  "cancelExpression": "doitEtreCloture",
  "allowMultipleInstances": false,
  "initialStepId": "diagnostic",
  "steps": [
    {
      "id": "diagnostic",
      "type": "FORM",
      "title": "Diagnostic de grossesse",
      "formId": "41977aa6-79cb-45f2-b196-d3b1705634a8",
      "nextStepId": "est_enceinte"
    },
    {
      "id": "est_enceinte",
      "type": "CONDITION",
      "title": "Grossesse confirmée ?",
      "cases": [
        {
          "if": "grossesseConfirmee",
          "then": "cpn"
        }
      ],
      "else": "fin_non_enceinte"
    },
    {
      "id": "fin_non_enceinte",
      "type": "END",
      "title": "Pas de grossesse",
      "finalMessage": "Test négatif : pas de grossesse. Suivi terminé."
    },
    {
      "id": "cpn",
      "type": "FORM",
      "title": "Consultation prénatale (CPN)",
      "formId": "d16cb752-dc45-4364-891e-c186cebf0d65",
      "nextStepId": "a_accouche"
    },
    {
      "id": "a_accouche",
      "type": "CONDITION",
      "title": "Accouchement survenu ?",
      "cases": [
        {
          "if": "accouchementSurvenu",
          "then": "accouchement"
        }
      ],
      "else": "cpn"
    },
    {
      "id": "accouchement",
      "type": "FORM",
      "title": "Accouchement",
      "formId": "13c64490-9d0b-495d-965f-35eb0dae5fdc",
      "nextStepId": "postnatal"
    },
    {
      "id": "postnatal",
      "type": "FORM",
      "title": "Suivi postnatal (CPoN)",
      "formId": "0f878470-9a6d-42b0-aff2-c7eb6f1d56c6",
      "nextStepId": "fin"
    },
    {
      "id": "fin",
      "type": "END",
      "title": "Suivi terminé",
      "finalMessage": "Suivi de grossesse et postnatal terminé."
    }
  ]
}