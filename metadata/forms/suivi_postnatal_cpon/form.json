{
  "id": "0f878470-9a6d-42b0-aff2-c7eb6f1d56c6",
  "name": "suivi_postnatal_cpon",
  "title": "Suivi postnatal (CPoN)",
  "version": "1.0.0",
  "icon": "form_default",
  "className": "",
  "displayExpression": "showForm",
  "duration": 30,
  "sections": [
    {
      "key": "3f9b57f9-087d-4ca9-acbf-bb860f286cb7",
      "title": "Visite postnatale",
      "icon": "layout-group",
      "collapsible": "(app) => false",
      "fullPage": "(app) => true",
      "isRepeatable": "(app) => false",
      "repeatCount": "(app) => 2",
      "displayExpression": "(app) => true",
      "fields": [
        {
          "key": "jours_depuis_accouchement",
          "label": "Jours depuis l'accouchement",
          "dataType": "function",
          "tags": [],
          "className": "",
          "calculationExpression": "daysSinceDelivery",
          "displayExpression": "(app) => false"
        },
        {
          "key": "date_de_la_visite",
          "label": "Date de la visite",
          "dataType": "date",
          "dataElementId": "a821f10e-dc45-49d2-aece-86f6bc04cd9d",
          "tags": [],
          "className": "",
          "required": "(app) => true",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => !((app.currentForm.date_de_la_visite ?? '') !== '') || String(app.currentForm.date_de_la_visite).slice(0, 10) <= new Date().toISOString().slice(0, 10)",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "La date ne peut pas être dans le futur",
          "defaultValue": "today"
        },
        {
          "key": "resume_post_partum",
          "label": "Visite à **J{app.currentForm.jours_depuis_accouchement}** après l'accouchement.",
          "dataType": "label",
          "alertType": "info",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => app.currentForm.jours_depuis_accouchement != null"
        },
        {
          "key": "type_de_visite_postnatale",
          "label": "Type de visite postnatale",
          "dataType": "select_one",
          "dataElementId": "0daf8743-d00f-4ad5-8353-43730d29ad83",
          "tags": [],
          "className": "",
          "required": "(app) => true",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur invalide",
          "defaultValue": "defaultVisitType"
        },
        {
          "key": "etat_de_la_mere",
          "label": "État de la mère",
          "dataType": "select_one",
          "dataElementId": "f693a9a2-4de6-4e01-bc4c-f29ffcf50626",
          "tags": [],
          "className": "",
          "required": "(app) => true",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur invalide"
        },
        {
          "key": "info_mere_decedee",
          "label": "Décès maternel : le suivi de la femme sera clôturé. Notifier le superviseur.",
          "dataType": "label",
          "alertType": "warning",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => app.currentForm.etat_de_la_mere === 'decedee'"
        },
        {
          "key": "etat_du_nouveaune",
          "label": "État du nouveau-né",
          "dataType": "select_one",
          "dataElementId": "ed8b482f-27aa-4d35-8936-f444bf59000b",
          "tags": [],
          "className": "",
          "required": "(app) => true",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur invalide"
        },
        {
          "key": "allaitement_exclusif",
          "label": "Allaitement exclusif",
          "dataType": "boolean",
          "dataElementId": "564bb680-5de9-4077-82d4-5980f37c81e5",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => app.currentForm.etat_du_nouveaune !== 'decede'",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur invalide"
        },
        {
          "key": "methode_de_planification_familiale_adoptee",
          "label": "Méthode de planification familiale adoptée",
          "dataType": "select_one",
          "dataElementId": "73c8df23-fa3b-43f3-a319-8350e44f51fb",
          "tags": [],
          "className": "",
          "required": "(app) => app.currentForm.type_de_visite_postnatale === 's6' && app.currentForm.etat_de_la_mere !== 'decedee'",
          "displayExpression": "(app) => app.currentForm.type_de_visite_postnatale === 's6' && app.currentForm.etat_de_la_mere !== 'decedee'",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur invalide"
        },
        {
          "key": "alerte_reference",
          "label": "**Référer {app.currentForm.etat_de_la_mere === 'signes_danger' && app.currentForm.etat_du_nouveaune === 'signes_danger' ? 'la mère et le nouveau-né' : app.currentForm.etat_de_la_mere === 'signes_danger' ? 'la mère' : 'le nouveau-né'} en urgence.**",
          "dataType": "label",
          "alertType": "danger",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => app.currentForm.etat_de_la_mere === 'signes_danger' || app.currentForm.etat_du_nouveaune === 'signes_danger'"
        },
        {
          "key": "referee",
          "label": "Référée",
          "dataType": "boolean",
          "dataElementId": "15375ba9-539e-4d39-acbb-dc0e3b29f2d2",
          "tags": [],
          "className": "",
          "required": "(app) => app.currentForm.etat_de_la_mere === 'signes_danger' || app.currentForm.etat_du_nouveaune === 'signes_danger'",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "La femme a-t-elle été référée vers une structure de santé ?",
          "requiredMessage": "Signe de danger détecté : indiquer si la référence a été faite",
          "validationMessage": "Valeur invalide"
        }
      ]
    }
  ]
}
