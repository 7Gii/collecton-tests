  "duration": 30,
  "sections": [
    {
      "key": "2919a88d-93fc-4e09-8894-67a5f314768c",
      "title": "Accouchement",
      "icon": "layout-group",
      "collapsible": "(app) => false",
      "fullPage": "(app) => true",
      "isRepeatable": "(app) => false",
      "repeatCount": "(app) => 2",
      "displayExpression": "(app) => true",
      "fields": [
        {
          "key": "date_de_laccouchement",
          "label": "Date de l'accouchement",
          "dataType": "date",
          "dataElementId": "f4e7c820-de07-4f86-9e4c-3b933ee3c69a",
          "tags": [],
          "className": "",
          "required": "(app) => true",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => !((app.currentForm.date_de_laccouchement ?? '') !== '') || String(app.currentForm.date_de_laccouchement).slice(0, 10) <= new Date().toISOString().slice(0, 10)",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "La date ne peut pas être dans le futur",
          "defaultValue": "today"
        },
        {
          "key": "lieu_de_laccouchement",
          "label": "Lieu de l'accouchement",
          "dataType": "select_one",
          "dataElementId": "2f0e2239-49cb-4fb4-bbb8-af6ccb820892",
          "tags": [],
          "className": "",
          "required": "(app) => true",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur invalide"
        },
        {
          "key": "info_domicile",
          "label": "Accouchement à domicile : orienter la mère et le nouveau-né vers la structure de santé dans les 24 h.",
          "dataType": "label",
          "alertType": "warning",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => app.currentForm.lieu_de_laccouchement === 'domicile'"
        },
        {
          "key": "mode_daccouchement",
          "label": "Mode d'accouchement",
          "dataType": "select_one",
          "dataElementId": "72a15389-6337-4fbf-9f31-092a2773cbeb",
          "tags": [],
          "className": "",
          "required": "(app) => true",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur invalide"
        },
        {
          "key": "issue_de_laccouchement",
          "label": "Issue de l'accouchement",
          "dataType": "select_one",
          "dataElementId": "752d72e7-27f1-477a-bf46-aee01b11b01d",
          "tags": [],
          "className": "",
          "required": "(app) => true",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur invalide"
        },
        {
          "key": "info_mort_ne",
          "label": "Proposer un accompagnement psychologique à la mère.",
          "dataType": "label",
          "alertType": "info",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => app.currentForm.issue_de_laccouchement === 'mort_ne'"
        },
        {
          "key": "nombre_de_bebes",
          "label": "Nombre de bébés",
          "dataType": "integer",
          "dataElementId": "daf74241-3ed6-4f9c-8e8d-c86b863d41c3",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => !((app.currentForm.nombre_de_bebes ?? '') !== '') || (Number(app.currentForm.nombre_de_bebes) >= 1 && Number(app.currentForm.nombre_de_bebes) <= 5)",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur attendue entre 1 et 5",
          "defaultValue": "(app) => 1"
        },
        {
          "key": "complications",
          "label": "Complications",
          "dataType": "select_multiple",
          "dataElementId": "497f7f6a-7b20-433f-ae9a-f9383592c3ba",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => !((app.currentForm.complications || []).includes('aucune') && (app.currentForm.complications || []).length > 1)",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "« Aucune » ne peut pas être combinée avec une complication"
        },
        {
          "key": "alerte_complications",
          "label": "**{(app.currentForm.complications || []).filter(v => v !== 'aucune').length} complication(s) signalée(s)** : référer la mère si ce n'est pas déjà fait.",
          "dataType": "label",
          "alertType": "danger",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => (app.currentForm.complications || []).filter(v => v !== 'aucune').length > 0"
        }
      ]
    },
    {
      "key": "a4f1bea2-0d0e-4d78-949f-ece38719e7d3",
      "title": "Nouveau-né",
      "icon": "layout-group",
      "collapsible": "(app) => false",
      "fullPage": "(app) => true",
      "isRepeatable": "(app) => false",
      "repeatCount": "(app) => 2",
      "displayExpression": "(app) => app.currentForm.issue_de_laccouchement === 'naissance_vivante'",
      "fields": [
        {
          "key": "poids_du_bebe_g",
          "label": "Poids du bébé (g){Number(app.currentForm.nombre_de_bebes) > 1 ? ' - premier né' : ''}",
          "dataType": "integer",
          "dataElementId": "2eb52d05-5c0e-4558-ab3f-6067598c6eaf",
          "tags": [],
          "className": "",
          "required": "(app) => true",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => !((app.currentForm.poids_du_bebe_g ?? '') !== '') || (Number(app.currentForm.poids_du_bebe_g) >= 300 && Number(app.currentForm.poids_du_bebe_g) <= 6000)",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur attendue entre 300 et 6000 g"
        },
        {
          "key": "categorie_poids_naissance",
          "label": "Catégorie de poids de naissance",
          "dataType": "function",
          "tags": [],
          "className": "",
          "calculationExpression": "birthWeightClass",
          "displayExpression": "(app) => false"
        },
        {
          "key": "alerte_petit_poids",
          "label": "**{app.currentForm.categorie_poids_naissance === 'very_low' ? 'Très petit poids' : 'Petit poids'} de naissance ({app.currentForm.poids_du_bebe_g} g)** : méthode mère kangourou et référence du nouveau-né.",
          "dataType": "label",
          "alertType": "danger",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => ['low', 'very_low'].includes(app.currentForm.categorie_poids_naissance)"
        },
        {
          "key": "info_poids_normal",
          "label": "Poids de naissance normal.",
          "dataType": "label",
          "alertType": "success",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => app.currentForm.categorie_poids_naissance === 'normal'"
        }
      ]
    }
  ]
}
