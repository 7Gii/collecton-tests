{
  "id": "d16cb752-dc45-4364-891e-c186cebf0d65",
  "name": "consultation_prenatale_cpn",
  "title": "Consultation prénatale (CPN)",
  "version": "1.0.0",
  "icon": "form_default",
  "className": "",
  "displayExpression": "showForm",
  "duration": 30,
  "sections": [
    {
      "key": "6c927c44-1e3d-4716-a9df-fec2495c253e",
      "title": "Consultation prénatale",
      "icon": "layout-group",
      "collapsible": "(app) => false",
      "fullPage": "(app) => true",
      "isRepeatable": "(app) => false",
      "repeatCount": "(app) => 2",
      "displayExpression": "(app) => true",
      "fields": [
        {
          "key": "date_de_la_cpn",
          "label": "Date de la CPN",
          "dataType": "date",
          "dataElementId": "a4a7b7c4-182d-4e56-a435-bbc445e101d5",
          "tags": [],
          "className": "",
          "required": "(app) => true",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => !((app.currentForm.date_de_la_cpn ?? '') !== '') || String(app.currentForm.date_de_la_cpn).slice(0, 10) <= new Date().toISOString().slice(0, 10)",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "La date ne peut pas être dans le futur",
          "defaultValue": "today"
        },
        {
          "key": "numero_de_la_cpn",
          "label": "Numéro de la CPN",
          "dataType": "select_one",
          "dataElementId": "855edfd9-6e16-442e-8151-e91e5680e84d",
          "tags": [],
          "className": "",
          "required": "(app) => true",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur invalide",
          "defaultValue": "nextCpnNumber"
        },
        {
          "key": "age_gestationnel_semaines",
          "label": "Âge gestationnel (semaines)",
          "dataType": "integer",
          "dataElementId": "0c53d529-ff8d-4a0d-97c7-54443e903ef4",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur invalide",
          "calculationExpression": "gestationalAgeWeeks"
        },
        {
          "key": "resume_age_gestationnel",
          "label": "Âge gestationnel : **{app.currentForm.age_gestationnel_semaines} semaines d'aménorrhée** ({app.currentForm.age_gestationnel_semaines < 14 ? '1er' : app.currentForm.age_gestationnel_semaines < 28 ? '2e' : '3e'} trimestre)",
          "dataType": "label",
          "alertType": "info",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => app.currentForm.age_gestationnel_semaines != null"
        },
        {
          "key": "age_gestationnel_inconnu",
          "label": "Âge gestationnel inconnu : aucune DDR dans le diagnostic de grossesse.",
          "dataType": "label",
          "alertType": "none",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => !(app.currentForm.age_gestationnel_semaines != null)"
        },
        {
          "key": "tension_systolique",
          "label": "Tension systolique",
          "dataType": "integer",
          "dataElementId": "1f9f2336-8ccf-46c8-b398-c5d1728d72c1",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => !((app.currentForm.tension_systolique ?? '') !== '') || (Number(app.currentForm.tension_systolique) >= 60 && Number(app.currentForm.tension_systolique) <= 250)",
          "placeholder": "",
          "hint": "En mmHg",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur attendue entre 60 et 250 mmHg"
        },
        {
          "key": "tension_diastolique",
          "label": "Tension diastolique",
          "dataType": "integer",
          "dataElementId": "dd2e345a-b90b-43a1-a698-e1173a2747a0",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => !((app.currentForm.tension_diastolique ?? '') !== '') || (Number(app.currentForm.tension_diastolique) >= 30 && Number(app.currentForm.tension_diastolique) <= 150 && (!((app.currentForm.tension_systolique ?? '') !== '') || Number(app.currentForm.tension_diastolique) < Number(app.currentForm.tension_systolique)))",
          "placeholder": "",
          "hint": "En mmHg",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur attendue entre 30 et 150 mmHg, inférieure à la systolique"
        },
        {
          "key": "alerte_hypertension",
          "label": "**Tension élevée : {app.currentForm.tension_systolique}/{app.currentForm.tension_diastolique} mmHg.** Référer la femme (risque de pré-éclampsie).",
          "dataType": "label",
          "alertType": "danger",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => (Number(app.currentForm.tension_systolique) >= 140 || Number(app.currentForm.tension_diastolique) >= 90)"
        },
        {
          "key": "poids_kg",
          "label": "Poids (kg)",
          "dataType": "decimal",
          "dataElementId": "ad341217-0f1d-4617-9eeb-5d47d9b03ae1",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => !((app.currentForm.poids_kg ?? '') !== '') || (Number(app.currentForm.poids_kg) >= 30 && Number(app.currentForm.poids_kg) <= 200)",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur attendue entre 30 et 200 kg"
        },
        {
          "key": "hemoglobine_gdl",
          "label": "Hémoglobine (g/dL)",
          "dataType": "decimal",
          "dataElementId": "cc259702-bd6b-4f8b-a66b-7ae10b1afd3d",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => !((app.currentForm.hemoglobine_gdl ?? '') !== '') || (Number(app.currentForm.hemoglobine_gdl) >= 3 && Number(app.currentForm.hemoglobine_gdl) <= 20)",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur attendue entre 3 et 20 g/dL"
        },
        {
          "key": "alerte_anemie",
          "label": "**Anémie {Number(app.currentForm.hemoglobine_gdl) < 7 ? 'sévère' : 'modérée'}** (Hb {app.currentForm.hemoglobine_gdl} g/dL).",
          "dataType": "label",
          "alertType": "warning",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => (app.currentForm.hemoglobine_gdl ?? '') !== '' && Number(app.currentForm.hemoglobine_gdl) < 11"
        },
        {
          "key": "signes_de_danger",
          "label": "Signes de danger",
          "dataType": "select_multiple",
          "dataElementId": "a52ce1cb-2481-476c-bba3-1d8052020153",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => !((app.currentForm.signes_de_danger || []).includes('aucun') && (app.currentForm.signes_de_danger || []).length > 1)",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "« Aucun » ne peut pas être combiné avec un signe de danger"
        },
        {
          "key": "alerte_signes_danger",
          "label": "**{(app.currentForm.signes_de_danger || []).filter(v => v !== 'aucun').length} signe(s) de danger** : référer la femme en urgence.",
          "dataType": "label",
          "alertType": "danger",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => (app.currentForm.signes_de_danger || []).filter(v => v !== 'aucun').length > 0"
        },
        {
          "key": "tpi_recu",
          "label": "TPI reçu",
          "dataType": "boolean",
          "dataElementId": "69ba7ba7-05d7-4004-a320-68f15dceba0c",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => !(app.currentForm.age_gestationnel_semaines != null) || Number(app.currentForm.age_gestationnel_semaines) >= 13",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "Traitement préventif intermittent du paludisme, à partir de 13 semaines",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur invalide"
        },
        {
          "key": "vat_recu",
          "label": "VAT reçu",
          "dataType": "boolean",
          "dataElementId": "8d06b877-59de-4501-8548-ac4123eb868a",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "Vaccin antitétanique",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur invalide"
        },
        {
          "key": "referee",
          "label": "Référée",
          "dataType": "boolean",
          "dataElementId": "15375ba9-539e-4d39-acbb-dc0e3b29f2d2",
          "tags": [],
          "className": "",
          "required": "(app) => (app.currentForm.signes_de_danger || []).filter(v => v !== 'aucun').length > 0 || (Number(app.currentForm.tension_systolique) >= 140 || Number(app.currentForm.tension_diastolique) >= 90) || ((app.currentForm.hemoglobine_gdl ?? '') !== '' && Number(app.currentForm.hemoglobine_gdl) < 7)",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "La femme a-t-elle été référée vers une structure de santé ?",
          "requiredMessage": "Situation à risque détectée : indiquer si la femme a été référée",
          "validationMessage": "Valeur invalide"
        },
        {
          "key": "accouchement_survenu",
          "label": "Accouchement survenu",
          "dataType": "select_one",
          "dataElementId": "b8a7bb5a-8e7d-4352-ace3-244b029c4633",
          "tags": [],
          "className": "",
          "required": "(app) => true",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "Répondre Oui si la femme a accouché depuis la dernière visite",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur invalide"
        },
        {
          "key": "info_accouchement",
          "label": "Le formulaire Accouchement sera proposé à l'étape suivante du suivi.",
          "dataType": "label",
          "alertType": "info",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => app.currentForm.accouchement_survenu === 'oui'"
        }
      ]
    }
  ]
}
