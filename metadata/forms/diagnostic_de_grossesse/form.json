{
  "id": "41977aa6-79cb-45f2-b196-d3b1705634a8",
  "name": "diagnostic_de_grossesse",
  "title": "Diagnostic de grossesse",
  "version": "1.1.0",
  "icon": "form_default",
  "className": "",
  "displayExpression": "showForm",
  "duration": 365,
  "sections": [
    {
      "key": "c75085f8-a885-459e-a47b-8bb12b956628",
      "title": "Diagnostic",
      "icon": "layout-group",
      "collapsible": "(app) => false",
      "fullPage": "(app) => true",
      "isRepeatable": "(app) => false",
      "repeatCount": "(app) => 2",
      "displayExpression": "(app) => true",
      "fields": [
        {
          "key": "date_de_la_visite",
          "label": "Date de la visite",
          "dataType": "date",
          "dataElementId": "a821f10e-dc45-49d2-aece-86f6bc04cd9d",
          "tags": [],
          "className": "",
          "required": "(app) => true",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => !((app.currentForm.date_de_la_visite ?? '') !== '') || String(app.currentForm.date_de_la_visite).slice(0, 10) <= new Date().toISOString().slice(0, 10)",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "La date ne peut pas être dans le futur",
          "defaultValue": "today"
        },
        {
          "key": "resultat_du_test_de_grossesse",
          "label": "Résultat du test de grossesse",
          "dataType": "select_one",
          "dataElementId": "5e35a5d9-5e77-4a47-8f82-4cba8a36b63b",
          "tags": [],
          "className": "",
          "required": "(app) => true",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur invalide"
        },
        {
          "key": "info_test_negatif",
          "label": "Test négatif : le suivi de grossesse s'arrête ici. Conseiller la femme sur la planification familiale.",
          "dataType": "label",
          "alertType": "warning",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => app.currentForm.resultat_du_test_de_grossesse === 'negatif'"
        },
        {
          "key": "date_des_dernieres_regles_ddr",
          "label": "Date des dernières règles (DDR)",
          "dataType": "date",
          "dataElementId": "a756d7d7-4d5d-4514-bc1f-5590f2f39e74",
          "tags": [],
          "className": "",
          "required": "(app) => app.currentForm.resultat_du_test_de_grossesse === 'positif'",
          "displayExpression": "(app) => app.currentForm.resultat_du_test_de_grossesse === 'positif'",
          "validationExpression": "(app) => !((app.currentForm.date_des_dernieres_regles_ddr ?? '') !== '') || (new Date(app.currentForm.date_des_dernieres_regles_ddr) <= new Date() && (Date.now() - new Date(app.currentForm.date_des_dernieres_regles_ddr).getTime()) / 86400000 <= 300)",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "La DDR est obligatoire quand le test est positif",
          "validationMessage": "La DDR doit être passée et dater de moins de 10 mois"
        },
        {
          "key": "date_prevue_daccouchement",
          "label": "Date prévue d'accouchement",
          "dataType": "date",
          "dataElementId": "c6b5f716-1095-4e88-ad3b-21b9a7d143e6",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => app.currentForm.resultat_du_test_de_grossesse === 'positif'",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "Calculée automatiquement : DDR + 280 jours",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur invalide",
          "calculationExpression": "expectedDeliveryDate"
        },
        {
          "key": "age_gestationnel_semaines",
          "label": "Âge gestationnel (semaines)",
          "dataType": "integer",
          "dataElementId": "0c53d529-ff8d-4a0d-97c7-54443e903ef4",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => app.currentForm.resultat_du_test_de_grossesse === 'positif'",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "Valeur invalide",
          "calculationExpression": "gestationalAgeWeeks"
        },
        {
          "key": "resume_grossesse",
          "label": "**Grossesse de {app.currentForm.age_gestationnel_semaines} semaines** - accouchement prévu le **{app.currentForm.date_prevue_daccouchement.split('-').reverse().join('/')}**",
          "dataType": "label",
          "alertType": "info",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => !!app.currentForm.date_prevue_daccouchement && app.currentForm.age_gestationnel_semaines != null"
        },
        {
          "key": "gestite",
          "label": "Gestité",
          "dataType": "integer",
          "dataElementId": "611c441a-c5f2-49e2-8efe-3842f2c7f134",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => app.currentForm.resultat_du_test_de_grossesse === 'positif'",
          "validationExpression": "(app) => !((app.currentForm.gestite ?? '') !== '') || (Number(app.currentForm.gestite) >= 1 && Number(app.currentForm.gestite) <= 20)",
          "placeholder": "",
          "hint": "Nombre total de grossesses, y compris l'actuelle",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "La gestité doit être comprise entre 1 et 20"
        },
        {
          "key": "parite",
          "label": "Parité",
          "dataType": "integer",
          "dataElementId": "73114d3f-afb8-4e3d-ae69-f1e85be6cfe8",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => app.currentForm.resultat_du_test_de_grossesse === 'positif'",
          "validationExpression": "(app) => !((app.currentForm.parite ?? '') !== '') || !((app.currentForm.gestite ?? '') !== '') || (Number(app.currentForm.parite) >= 0 && Number(app.currentForm.parite) < Number(app.currentForm.gestite))",
          "placeholder": "",
          "hint": "Nombre d'accouchements antérieurs",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "La parité doit être inférieure à la gestité (grossesse en cours incluse)"
        },
        {
          "key": "antecedents",
          "label": "Antécédents",
          "dataType": "select_multiple",
          "dataElementId": "05d6871a-8e70-460d-a0cc-3abbfba4062c",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => app.currentForm.resultat_du_test_de_grossesse === 'positif'",
          "validationExpression": "(app) => !((app.currentForm.antecedents || []).includes('aucun') && (app.currentForm.antecedents || []).length > 1)",
          "placeholder": "",
          "hint": "",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "« Aucun » ne peut pas être combiné avec un antécédent"
        },
        {
          "key": "alerte_grossesse_a_risque",
          "label": "**Grossesse à risque** ({Number(app.currentForm.gestite) >= 5 ? 'grande multigeste' : 'antécédents obstétricaux'}) : orienter la femme vers une CPN en structure de santé.",
          "dataType": "label",
          "alertType": "danger",
          "tags": [],
          "className": "",
          "displayExpression": "(app) => app.currentForm.resultat_du_test_de_grossesse === 'positif' && ((app.currentForm.antecedents || []).filter(v => v !== 'aucun').length > 0 || Number(app.currentForm.gestite) >= 5)"
        },
        {
          "key": "position_du_domicile",
          "label": "Position du domicile (GPS)",
          "dataType": "geopoint",
          "dataElementId": "46975387-25d7-4da3-ad1c-a131d57f5e56",
          "tags": [],
          "className": "",
          "required": "(app) => false",
          "displayExpression": "(app) => true",
          "validationExpression": "(app) => true",
          "placeholder": "",
          "hint": "Capturer la position GPS du domicile pour les visites de suivi",
          "requiredMessage": "Cette valeur est obligatoire",
          "validationMessage": "La valeur est invalide"
        }
      ]
    }
  ]
}
