  {
   "type": "calculate",
   "name": "patient_age_in_years",
   "label::en": "Years",
   "label::fr": "Années",
   "label::bm": "San",
   "default": 0,
   "calculation": "floor( difference-in-months( ${date_of_birth}, now() ) div 12 )"
  },
  {
   "type": "calculate",
   "name": "patient_age_in_months",
   "label::en": "Months",
   "label::fr": "Mois",
   "label::bm": "Kalo",
   "default": 0,
   "calculation": "difference-in-months( ${date_of_birth}, now() )"
  },
  {
   "type": "calculate",
   "name": "patient_age_in_days",
   "label::en": "Days old",
   "label::fr": "Jours",
   "label::bm": "Tile",
   "calculation": "floor( decimal-date-time(now()) - decimal-date-time(${date_of_birth}) )"
  },
  {
   "type": "calculate",
   "name": "patient_age_display",
   "calculation": "concat(concat(${patient_age_in_years}, if(${patient_age_in_years}=1,' year and ',' years and ')),concat(${patient_age_in_months} mod 12, if((${patient_age_in_months} mod 12)=1,' month old',' months old')))"
  },
  {
   "type": "calculate",
   "name": "patient_age_display_fr",
   "calculation": "concat(concat(${patient_age_in_years}, if(${patient_age_in_years}=1,' an et ',' ans et ')),concat(${patient_age_in_months} mod 12, ' mois'))"
  },
  {
   "type": "calculate",
   "name": "patient_age_display_bm",
   "calculation": "concat(concat('San ', ${patient_age_in_years}, ' ani '), concat(' Kalo ', ${patient_age_in_months} mod 12))"
  },
  {
   "type": "calculate",
   "name": "patient_sex",
   "calculation": "../inputs/contact/sex"
  },
  {
   "type": "calculate",
   "name": "patient_sex_normalized",
   "calculation": "if(${patient_sex} = 'male' or ${patient_sex} = 'homme' or ${patient_sex} = 'Homme', 'male', if(${patient_sex} = 'female' or ${patient_sex} = 'femme' or ${patient_sex} = 'Femme', 'female', ''))",
   "instance::tag": "hidden"
  },
  {
   "type": "calculate",
   "name": "patient_sex_fr",
   "calculation": "if(${patient_sex} = 'male' or ${patient_sex} = 'homme' or ${patient_sex} = 'Homme', 'Homme', if(${patient_sex} = 'female' or ${patient_sex} = 'femme' or ${patient_sex} = 'Femme', 'Femme', ''))",
   "instance::tag": "hidden"
  },
  {
   "type": "calculate",
   "name": "patient_sex_bm",
   "calculation": "if(${patient_sex} = 'male' or ${patient_sex} = 'homme' or ${patient_sex} = 'Homme', 'Cɛ', if(${patient_sex} = 'female' or ${patient_sex} = 'femme' or ${patient_sex} = 'Femme', 'Muso', ''))",
   "instance::tag": "hidden"
  },
  {
   "type": "calculate",
   "name": "patient_id",
   "calculation": "../inputs/contact/_id"
  },
  {
   "type": "calculate",
   "name": "muso_id",
