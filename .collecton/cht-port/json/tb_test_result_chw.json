  {
   "type": "begin group",
   "name": "g_followup_task",
   "label::en": "Patient Follow-up",
   "label::fr": "Suivi du Patient",
   "label::bm": "Banabagatɔ ka kɔlɔsili",
   "appearance": "field-list summary"
  },
  {
   "type": "select_one c_task_to_perform",
   "name": "s_task_to_perform",
   "label::en": "What task do you want to perform?",
   "label::fr": "Quelle est la tâche à effectuer ?",
   "label::bm": "Baarakɛta ye jumɛn ye ?",
   "required": "yes",
   "required_message::en": "This is required",
   "required_message::fr": "Cela est obligatoire",
   "required_message::bm": "O ka kan ka kɛ"
  },
  {
   "type": "select_one yes_no",
   "name": "s_have_ppe",
   "label::en": "Do you have Personal Protective Equipment (PPE)?",
   "label::fr": "Avez-vous un Equipement de Protection Individuel (EPI)?",
   "label::bm": "Yala yɛrɛ tanga minɛw b'i bolo wa?",
   "required": "yes",
   "required_message::en": "This is required",
   "required_message::fr": "Cela est obligatoire",
   "required_message::bm": "O ka kan ka kɛ",
   "relevant": "${s_task_to_perform} = 'follow_up'"
  },
  {
   "type": "note",
   "name": "n_epi_no_touch_note",
   "label::en": "It is strongly recommended not to touch the patient without PPE. It is advised to perform this task without touching the patient.",
   "label::fr": "Il est fortement recommandé sans EPI de ne pas toucher le patient. Il est conseillé d'effectuer cette tâche sans toucher le patient.",
   "label::bm": "I ma ka maga banabagotɔ la ka sɔrɔ i m'a tanga minɛw do A laɲininen do i fɛ, i ka furakɛli kɛ ka sɔrɔ i m'a maga banabagotɔ la walima telefɔni la",
   "appearance": "h3 red",
   "relevant": "${s_have_ppe} = 'no'"
  },
  {
   "type": "note",
   "name": "n_epi_reminder",
   "label::en": "Make sure to wear your PPE properly and follow protection rules.",
   "label::fr": "Assurez-vous de bien mettre votre EPI et de respecter les règles de protection.",
   "label::bm": "D’ala k’i ye yɛrɛ tanga minɛw don ka xq ani ka tangali fqqrqw b’a sira fq.",
   "appearance": "h3 green",
   "relevant": "${s_have_ppe} = 'yes'"
  },
  {
   "type": "note",
   "name": "n_wash_hands",
   "label::en": "Wash your hands before and after each operation.",
   "label::fr": "Lavez-vous les mains avant et après chaque opération.",
   "label::bm": "I tɛgɛ ko ka jɛ ka kon ani n’i tilala baara sugu o sugu la.",
   "appearance": "h3 green",
   "relevant": "${s_have_ppe} = 'yes'"
  },
  {
   "type": "note",
   "name": "n_hygiene_note",
   "label::en": "Observe cough hygiene and disinfection of surfaces and equipment.",
   "label::fr": "Observer l'hygiène de la toux la désinfection des surfaces et des équipements.",
   "label::bm": "I hakili to sùgùsùgù saniya walew la, yùrùw ni baarakɛminɛw saniya la.",
   "appearance": "h3 green",
   "relevant": "${s_have_ppe} = 'yes'"
  },
  {
   "type": "select_one yes_no",
   "name": "s_followup_today",
   "label::en": "Was the follow-up done today?",
   "label::fr": "Le suivi du patient a t-il été fait aujourd'hui ?",
   "label::bm": "Kɔlɔsili kɛra bi wa?",
   "required": "yes",
   "required_message::en": "This is required",
   "required_message::fr": "Cela est obligatoire",
   "required_message::bm": "O ka kan ka kɛ"
  },
  {
   "type": "date",
   "name": "s_followup_date",
   "label::en": "Enter the follow-up date",
   "label::fr": "Entrez la date de suivi du patient",
   "label::bm": "Ni Ayi kiimɛli don do",
   "required": "yes",
   "required_message::en": "This is required",
   "required_message::fr": "Cela est obligatoire",
   "required_message::bm": "O ka kan ka kɛ",
   "relevant": "${s_followup_today} = 'no'",
   "constraint": ".<today()",
   "constraint_message::en": "Date cannot be in the future",
   "constraint_message::fr": "La date ne peut pas être dans le futur",
   "constraint_message::bm": "Don man kan ka kɛ tile nataw la"
  },
  {
   "type": "select_one c_why_close_out",
   "name": "s_why_close_out",
   "label::en": "Why do you want to close this follow-up?",
   "label::fr": "Pourquoi vous voulez clôre ce suivi?",
   "label::bm": "Munn’i b’a fɛ ka kɔlɔsili in kuncɛ ?",
   "required": "yes",
   "required_message::en": "This field is required",
   "required_message::fr": "Ce champ est obligatoire",
   "required_message::bm": "Ni yɔrɔ lafali ye wajibiye",
   "relevant": "${s_task_to_perform} = 'close_out'"
  },
  {
   "type": "note",
   "name": "n_death_note",
   "label::en": "The patient has died. Please complete the form \"Death Report\" for this patient.",
   "label::fr": "Le patient est décédé. Veuillez remplir le formulaire \"Rapport de Décès\" pour ce patient.",
