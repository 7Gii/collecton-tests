   "label::en": "<b>Reference/accompanying signs:</b> ${t_tb_diagnosis_en}",
   "label::fr": "<b>Signes de référence/accompagnement :</b>  ${t_tb_diagnosis_fr}",
   "label::bm": "<b>Sɛgɛsɛgɛli ( tamasiyɛn jugumanw kan):</b>  ${t_tb_diagnosis_bm}"
  },
