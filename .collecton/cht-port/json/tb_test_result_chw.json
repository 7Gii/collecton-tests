  },
  {
   "type": "calculate",
   "name": "tb_assessment_date_label",
   "calculation": "format-date-time(date-time(decimal-date-time(${t_tb_assessment_date})),\"%d/%m/%Y\")"
  },
  {
   "type": "calculate",
   "name": "tb_test_result",
   "calculation": "${s_tb_test_result}"
  },
  {
   "type": "calculate",
   "name": "tb_test_result_display",
   "calculation": "if(${tb_test_result}='pos','Positive',if(${tb_test_result}='neg','Negative','No result'))"
  },
  {
   "type": "calculate",
   "name": "tb_test_result_display_fr",
   "calculation": "if(${tb_test_result}='pos','Positif',if(${tb_test_result}='neg','Négatif','Pas de résultat'))"
  },
  {
   "type": "calculate",
   "name": "tb_test_result_display_bm",
   "calculation": "if(${tb_test_result}='pos','Positif',if(${tb_test_result}='neg','Négatif','Pas de résultat'))"
  },
  {
   "type": "calculate",
   "name": "s_tb_test_result_display",
   "calculation": "jr:choice-name(${s_tb_test_result}, '${s_tb_test_result}')"
  },
  {
   "type": "calculate",
   "name": "needs_signoff",
   "calculation": "\"true\""
  },
  {
   "type": "calculate",
   "name": "treatment_duration_in_days",
   "calculation": "if(${s_treatment_start_date} != '' and ${s_treatment_start_date} != '0', floor(decimal-date-time(now()) - decimal-date-time(${s_treatment_start_date})), 0)"
  },
  {
